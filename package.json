{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:client && vite build",
    "preview": "wrangler pages dev dist",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name webapp",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "node scripts/test-engine.mjs",
    "test:render": "node scripts/render-check.mjs",
    "verify": "npm run build && npm test && npm run test:render",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "esbuild": "^0.25.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}